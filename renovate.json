{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^deployments/.+/main\\.tf$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*charm=\"(?<depName>[^\"]+)\"\\s+track=\"(?<depTrack>[^\"]*)\"\\s+risk=\"(?<depRisk>[^\"]+)\"\\s+base=\"(?<depBase>[^\"]+)\"\\s+arch=\"(?<depArch>[^\"]+)\"\\s*\\n\\s*revision\\s*=\\s*(?<currentValue>\\d+)\\s*\\n"
      ],
      "packageNameTemplate": "{{{depName}}}:{{{depTrack}}}:{{{depRisk}}}:{{{depBase}}}:{{{depArch}}}",
      "registryUrlTemplate": "https://api.charmhub.io/v2/charms/info/{{{depName}}}?fields=channel-map",
      "versioningTemplate": "loose",
      "datasourceTemplate": "custom.charmhub"
    }
  ],
  "customDatasources": {
    "charmhub": {
      "format": "json",
      "transformTemplates": [
        "($parts := $split(\"{{{packageName}}}\", \":\"); {\"releases\": [{\"version\": $string(`channel-map`[channel.track = $parts[1] and channel.risk = $parts[2] and channel.base.channel = $parts[3] and channel.base.architecture = $parts[4]].revision.revision)}]})"
      ]
    }
  },
  "packageRules": [
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["module"],
      "versioning": "regex:^(?:[a-z]+-)?rev(?<major>\\d+)$",
      "automerge": true,
      "ignoreTests": true
    },
    {
      "matchDatasources": ["custom.charmhub"],
      "groupName": null,
      "automerge": true,
      "ignoreTests": true
    }
  ]
}
