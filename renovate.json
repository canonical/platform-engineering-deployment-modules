{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^deployments/.+/main\\.tf$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "#\\s*renovate:\\s*charm=\"(?<depName>[^\"]+)\"\\s+track=\"(?<depTrack>[^\"]*)\"\\s+risk=\"(?<depRisk>[^\"]+)\"\\s+base=\"(?<depBase>[^\"]+)\"\\s+arch=\"(?<depArch>[^\"]+)\"\\s*\\n\\s*revision\\s*=\\s*\\d+\\s*\\n",
        "revision\\s*=\\s*(?<currentValue>\\d+)\\s*\\n"
      ],
      "packageNameTemplate": "{{{depName}}}:{{{depTrack}}}:{{{depRisk}}}:{{{depBase}}}:{{{depArch}}}",
      "registryUrlTemplate": "https://api.charmhub.io/v2/charms/info/{{{depName}}}?fields=channel-map",
      "versioningTemplate": "loose",
      "datasourceTemplate": "custom.charmhub"
    }
  ],
  "customDatasources": {
    "charmhub": {
      "format": "json",
      "transformTemplates": [
        "($parts := $split(\"{{{packageName}}}\", \":\"); {\"releases\": [{\"version\": $string(`channel-map`[channel.track = $parts[1] and channel.risk = $parts[2] and channel.base.channel = $parts[3] and channel.base.architecture = $parts[4]].revision.revision)}]})"
      ]
    }
  },
  "packageRules": [
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["module"],
      "versioning": "regex:^(?:[a-z]+-)?rev(?<major>\\d+)$",
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "gopkg module refs: charm-ci tags gopkg-k8s-rev<N>, a multi-segment prefix the default regex above cannot parse (#208). The compatibility group pins updates to one tag family, so a ref never jumps to another charm's tags in the same repo.",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["module"],
      "matchFileNames": ["deployments/gopkg/ps7/main.tf"],
      "matchDepNames": ["github.com/canonical/gopkg-charmed"],
      "versioning": "regex:^(?<compatibility>(?:[a-z0-9]+-)*)rev(?<major>\\d+)$"
    },
    {
      "matchDatasources": ["custom.charmhub"],
      "groupName": null,
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "One PR per module (deployments/<app>/<site>), so each merge produces a single module tag. Must stay after the charmhub rule so groupName overrides its null. separateMajorMinor is off because charm revision bumps count as major updates and would otherwise split the group. Every module needs its own rule here (see AGENTS.md). gopkg/ps7 relies on this to bump its module ref and charm revision together.",
      "matchFileNames": ["deployments/bingo/ps7/**"],
      "groupName": "bingo-ps7",
      "separateMajorMinor": false
    },
    {
      "matchFileNames": ["deployments/falco/ps7/**"],
      "groupName": "falco-ps7",
      "separateMajorMinor": false
    },
    {
      "matchFileNames": ["deployments/falcosidekick/ps7/**"],
      "groupName": "falcosidekick-ps7",
      "separateMajorMinor": false
    },
    {
      "matchFileNames": ["deployments/gopkg/ps7/**"],
      "groupName": "gopkg-ps7",
      "separateMajorMinor": false
    },
    {
      "matchFileNames": ["deployments/lego/ps6/**"],
      "groupName": "lego-ps6",
      "separateMajorMinor": false
    },
    {
      "matchFileNames": ["deployments/mattermost/ps7/**"],
      "groupName": "mattermost-ps7",
      "separateMajorMinor": false
    },
    {
      "matchFileNames": ["deployments/opencti/ps6/**"],
      "groupName": "opencti-ps6",
      "separateMajorMinor": false
    },
    {
      "matchFileNames": ["deployments/wazuh/ps6/**"],
      "groupName": "wazuh-ps6",
      "separateMajorMinor": false
    }
  ]
}
