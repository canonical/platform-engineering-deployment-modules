{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^deployments/.+/main\\.tf$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*charm=\"(?<packageName>[^\"]+)\"\\s+track=\"(?<depTrack>[^\"]*)\"\\s+risk=\"(?<depRisk>[^\"]+)\"\\s+base=\"(?<depBase>[^\"]+)\"\\s+arch=\"(?<depArch>[^\"]+)\"\\s*\\n\\s*revision\\s*=\\s*(?<currentValue>\\d+)\\s*\\n"
      ],
      "versioningTemplate": "loose",
      "datasourceTemplate": "custom.charmhub"
    }
  ],
  "customDatasources": {
    "charmhub": {
      "defaultRegistryUrlTemplate": "https://api.charmhub.io/v2/charms/info/{{packageName}}?fields=channel-map",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $string($$.`channel-map`[channel.risk = '{{depRisk}}' and channel.track = '{{depTrack}}' and channel.base.architecture = '{{depArch}}' and channel.base.channel = '{{depBase}}'].revision.revision)}]}"
      ]
    }
  },
  "packageRules": [
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["module"],
      "versioning": "regex:^(?:[a-z]+-)?rev(?<major>\\d+)$",
      "automerge": true,
      "ignoreTests": true
    },
    {
      "matchDatasources": ["custom.charmhub"],
      "groupName": null,
      "automerge": true,
      "ignoreTests": true
    }
  ]
}
